datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model UserProfile {
  id                    String   @id @default("default-user")
  name                  String   @default("Vietnamese Learner")
  targetBand            Float    @default(6.5)
  currentBand           Float    @default(5.0)
  listeningBand         Float    @default(5.0)
  readingBand           Float    @default(5.5)
  writingBand           Float    @default(4.5)
  speakingBand          Float    @default(5.0)
  dailyGoalMinutes      Int      @default(45)
  streakDays            Int      @default(1)
  lastActiveDate        String   @default("")
  examDate              String?
  hasCompletedPlacement Boolean  @default(false)
  language              String   @default("vi") // "en" | "vi"
  theme                 String   @default("system") // "light" | "dark" | "system"
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Question {
  id                         String    @id @default(uuid())
  skill                      String // LISTENING, READING, WRITING, SPEAKING
  section                    Int? // 1, 2, 3, 4
  topic                      String
  questionType               String // mcq, true_false_not_given, etc.
  difficulty                 String // easy, medium, hard
  targetBand                 Float     @default(6.5)
  passageTitle               String?
  passageContent             String?
  passageContentVi           String?
  audioUrl                   String?
  transcript                 String?
  transcriptVi               String?
  instruction                String
  instructionVi              String?
  questionText               String
  questionTextVi             String?
  optionsJson                String? // JSON string
  correctAnswer              String // Single answer or JSON string for multiple
  explanationEn              String
  explanationVi              String
  evidenceQuote              String?
  distractorExplanationsJson String? // JSON string
  tagsJson                   String? // JSON string
  source                     String    @default("Original Practice Material")
  createdAt                  DateTime  @default(now())
  attempts                   Attempt[]
}

model VocabularyItem {
  id                String             @id @default(uuid())
  word              String             @unique
  ipa               String
  pos               String // noun, verb, adjective, adverb, phrase
  meaningVi         String
  definitionEn      String
  exampleSentence   String
  exampleSentenceVi String?
  collocationsJson  String // JSON string
  synonymsJson      String // JSON string
  antonymsJson      String // JSON string
  topic             String // Education, Environment, Technology, etc.
  difficulty        String // easy, medium, hard
  targetBand        Float              @default(6.5)
  createdAt         DateTime           @default(now())
  userProgress      UserVocabProgress?
}

model UserVocabProgress {
  id             String         @id @default(uuid())
  vocabId        String         @unique
  vocabulary     VocabularyItem @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  srsStage       String         @default("new") // new, learning, review, mastered
  interval       Int            @default(1)
  easeFactor     Float          @default(2.5)
  repetitions    Int            @default(0)
  nextReviewAt   DateTime       @default(now())
  correctCount   Int            @default(0)
  wrongCount     Int            @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model GrammarLesson {
  id                 String            @id @default(uuid())
  topicId            String            @unique // e.g. "tenses", "articles"
  title              String
  titleVi            String
  bandTarget         Float             @default(6.5)
  explanationEn      String
  explanationVi      String
  keyRulesJson       String // JSON string
  commonMistakesJson String // JSON string
  createdAt          DateTime          @default(now())
  exercises          GrammarExercise[]
}

model GrammarExercise {
  id            String        @id @default(uuid())
  lessonId      String
  lesson        GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  instruction   String
  instructionVi String?
  prompt        String
  promptVi      String?
  optionsJson   String? // JSON string
  correctAnswer String
  explanationEn String
  explanationVi String
  bandTrapNotes String?
  createdAt     DateTime      @default(now())
}

model Attempt {
  id            String   @id @default(uuid())
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userResponse  String
  isCorrect     Boolean
  score         Float
  timeSpentSecs Int      @default(0)
  createdAt     DateTime @default(now())
}

model Mistake {
  id              String    @id @default(uuid())
  skill           String // LISTENING, READING, WRITING, SPEAKING, GRAMMAR, VOCABULARY
  questionId      String?
  questionText    String
  questionType    String
  topic           String
  userAnswer      String
  correctAnswer   String
  explanationEn   String
  explanationVi   String
  evidenceQuote   String?
  mistakeReason   String?
  date            DateTime  @default(now())
  reviewCount     Int       @default(0)
  isResolved      Boolean   @default(false)
  lastPracticedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model WritingPrompt {
  id                     String              @id @default(uuid())
  taskType               String // TASK_1, TASK_2
  subType                String // line_graph, opinion, etc.
  title                  String
  titleVi                String
  prompt                 String
  promptVi               String
  imageUrl               String?
  suggestedStructureJson String // JSON string
  band65Sample           String
  keyVocabularyJson      String // JSON string
  createdAt              DateTime            @default(now())
  submissions            WritingSubmission[]
}

model WritingSubmission {
  id                String        @id @default(uuid())
  promptId          String
  prompt            WritingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  taskType          String
  content           String
  planNotes         String?
  wordCount         Int
  timeSpentSecs     Int
  taskResponseScore Float
  coherenceScore    Float
  lexicalScore      Float
  grammarScore      Float
  estimatedBand     Float
  evaluationJson    String // Full WritingEvaluation JSON
  createdAt         DateTime      @default(now())
}

model SpeakingPrompt {
  id                String               @id @default(uuid())
  part              Int // 1, 2, 3
  topic             String
  topicVi           String
  question          String
  questionVi        String
  cuesJson          String? // JSON string
  followUpsJson     String? // JSON string
  usefulPhrasesJson String // JSON string
  modelAnswer       String
  modelAudioUrl     String?
  createdAt         DateTime             @default(now())
  submissions       SpeakingSubmission[]
}

model SpeakingSubmission {
  id                 String         @id @default(uuid())
  promptId           String
  prompt             SpeakingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  part               Int
  audioPath          String?
  durationSecs       Int
  transcript         String
  fluencyScore       Float
  lexicalScore       Float
  grammarScore       Float
  pronunciationScore Float
  estimatedBand      Float
  evaluationJson     String // Full SpeakingEvaluation JSON
  createdAt          DateTime       @default(now())
}

model MockTest {
  id                String   @id @default(uuid())
  testType          String // FULL, SKILL, MINI
  listeningBand     Float?
  readingBand       Float?
  writingBand       Float?
  speakingBand      Float?
  overallBand       Float
  listeningRawScore Int?
  readingRawScore   Int?
  completedAt       DateTime @default(now())
  timeSpentSecs     Int      @default(0)
  detailsJson       String? // JSON string for breakdowns
}

model StudySession {
  id                 String   @id @default(uuid())
  date               String // YYYY-MM-DD
  plannedMinutes     Int
  actualMinutes      Int      @default(0)
  completedTasksJson String   @default("[]")
  createdAt          DateTime @default(now())
}
